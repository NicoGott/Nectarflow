// Every parameter of both pipelines, in one file, in three blocks:
//   1. shared     input, reference library, output
//   2. replica    the faithful re-implementation (replica.nf)
//   3. reanalysis the rebuilt pipeline        (reanalysis.nf)
// Defaults reproduce Lowe et al. 2022 (J Appl Ecol): pollen loads of bees and hoverflies, PRJNA763761.
params {
    // ─────────────────────────── 1. SHARED ───────────────────────────
    accession    = 'PRJNA763761'
    input        = null            // optional: your own samplesheet.csv instead of querying the archive
    samples      = ''              // optional: comma-separated sample aliases to keep
    max_samples  = -1              // -1 = all; use e.g. 20 while developing
    outdir       = 'results'

    // Answer key: Supporting_Data.xlsx from https://doi.org/10.5061/dryad.rjdfn2z9s
    published        = null

    // Barcode UK (Jones, Twyford et al. 2021): GenBank accession ranges from that paper's data statement.
    // Extension, as in Jones, Brennan et al. 2021: GenBank sequences for garden plants and naturalised
    // aliens. Here: the taxa in the published results that Barcode UK lacks. null = Barcode UK only.
    // the library is pinned: every accession and trim coordinate is fixed in the manifest, and the
    // sequences are vendored, so the build searches nothing and cannot drift with NCBI
    ref_manifest  = "${projectDir}/assets/reference_manifest.tsv"
    ref_sequences = "${projectDir}/assets/reference"

    // ──────────────────── 2. REPLICA (replica.nf) ────────────────────
    // Trimmomatic's stock adapter lists carry its own GPL-3 licence, so they are not copied
    // into this repository; TRIM takes them from the installed package by name. Their script
    // hard-codes NexteraPE-PE.fa, but these libraries are not Nextera, so TruSeq3 is the
    // default: on one raw sample the two differ by 2 surviving pairs in 74,280. A path of your
    // own also works. See docs/replica.md.
    adapters     = 'TruSeq3-PE-2.fa'      // a name inside Trimmomatic, or a path
    trim_quality = 20              // NOT documented by the authors: their script asks the user per project

    // Marker recognition, copied from their merged_demultiplex_by_primer.py:
    // a fragment of the forward primer near the start, of the reverse-complemented reverse primer near the end.
    markers = [
        rbcL: [ start: 'ACAGAGACTAAAGC', end: 'TGAACAAGTATGG',               min_len: 450 ],
        ITS2: [ start: 'ACTTGGTGTGAAT',  end: 'G[ACT]GACC[CT]CA[AG][AG]',     min_len: 300 ],   // UniPlantR
    ]
    // The paper says ITS2 > 350 bp, their code says 300. Following the paper would remove most of
    // the merged ITS2 reads and could not leave the 11.2 M ITS2 reads they report. We follow the
    // code; the read-length distribution that shows this is in the run's own stats, not quoted here.
    // Primer fragments and the forward-then-reverse rule are theirs, read from their script on
    // 5 October 2026; they match exactly. Some 2019 MiSeq reads miscall a base inside the rbcL
    // forward primer (low-diversity cycle); exact matching would lose the 43,037 the run's own
    // stats record, so the tolerance is 2.
    primer_mismatches = 2

    // 'derep' (default, fast) or 'align' (their vsearch --cluster_size --id 1.0, quadratic). See docs/replica.md stage 5.
    cluster_mode = 'derep'
    blast_chunk  = 25000          // clusters per BLAST task: an interruption loses at most one chunk

    // Tool versions: the ones in their pipeline (SLURM module lines in plant-pipeline.py).
    conda_trimmomatic = 'bioconda::trimmomatic=0.33'
    conda_flash       = 'bioconda::flash=1.2.11'
    conda_vsearch     = 'bioconda::vsearch=2.3.2'
    conda_blast       = 'bioconda::blast=2.2.31'

    // ───────────────── 3. REANALYSIS (reanalysis.nf) ─────────────────
    // Full primer sequences, read off the raw reads and matching the published names
    // (rbcLaf / rbcLr506; ITS2F / UniPlantR). R1 carries a 6-base random spacer in front of the
    // forward primer, R2 carries none. The ITS2 reverse primer appears with a constant CC in front
    // of UniPlantR (CGHYTGAYYTGRGGTCDC) in every read, so it is included.
    primers = [
        rbcL: [ fwd: 'NNNNNNATGTCACCACAAACAGAGACTAAAGC', rev: 'AGGGGACGACCATACTTGTTCA',
                rc_fwd: 'GCTTTAGTCTCTGTTTGTGGTGACAT',    rc_rev: 'TGAACAAGTATGGTCGTCCCCT' ],
        ITS2: [ fwd: 'NNNNNNATGCGATACTTGGTGTGAAT',       rev: 'CCCGHYTGAYYTGRGGTCDC',
                rc_fwd: 'ATTCACACCAAGTATCGCAT',          rc_rev: 'GHGACCYCARRTCARDCGGG' ],
    ]
    // DADA2 (phase 2). rbcL insert 458 bp without primers: 260 + 230 leaves 32 bp of overlap, and R2
    // quality falls below Q30 after cycle ~208. ITS2 is not truncated: its length varies by plant.
    dada2 = [
        rbcL: [ trunc_len: '260,230', max_ee: '2,2', min_overlap: 12 ],
        ITS2: [ trunc_len: '0,0',     max_ee: '2,2', min_overlap: 12 ],
    ]
    conda_dada2    = 'bioconda::bioconductor-dada2=1.30.0'
    // arm 2 classifies with a current BLAST+ (the pinned 2.2.31 of the faithful arm predates qcovhsp).
    conda_blast_current   = 'bioconda::blast=2.16.0'
    conda_vsearch_current = 'bioconda::vsearch=2.29.1'
    conda_mumu            = 'bioconda::mumu=1.1.4'

    // post-clustering curation, at the published defaults of Froslev et al. 2017; the result barely
    // moves between 84 and 99, because what decides a merge is co-occurrence, not similarity
    // mumu's defaults, which are LULU's published defaults. Left here so a run records them.
    lulu = [ min_match: 84, min_cooccurrence: 0.95, min_ratio: 1 ]
    max_target_seqs  = 500
    controls         = 'Extr_ctrl_1,Extr_ctrl_2,H2O_1,H2O_2'
    // Phases 5 and 6 read the faithful arm's outputs: point this at its results folder, the one
    // holding 08_tables and 09_comparison. Unset, the reanalysis simply runs on its own.
    replica_results          = null   // e.g. results/
    // mvabund is not packaged for conda (checked 23 Sep 2026), so conda_ecology may instead be a
    // prepared environment path: r-base, r-vegan, and mvabund installed from CRAN.
    // The run that produced docs/results.md used R 4.3.3, vegan 2.7.1 and mvabund 4.2.8; the
    // recipe that rebuilds exactly that is assets/ecology_env.yml. This spec is the fallback for
    // a quick run and does NOT pin the versions the published numbers came from.
    conda_ecology         = 'conda-forge::r-base=4.3 conda-forge::r-vegan'
    // Resamples for the mvabund community test. 999 is mvabund's own default and the value to
    // quote; at 199 every p in this study sat exactly on the 0.005 floor, which is not a
    // measurement. run_info.tsv records what was actually used. The PERMANOVA is not tied to this:
    // its permutations cost seconds, so ecology.R's own default of 999 stands.

    min_len_after_trim   = 50            // drop pairs left too short to denoise; DADA2 does the quality filtering
    conda_cutadapt = 'bioconda::cutadapt=4.9'

    published_sheets = [ rbcL: 'rbcL_consensus_ID_read_counts', ITS2: 'ITS2_consensus_ID_read_counts' ]
}

process {
    cpus = 2
    withName: 'CLUSTER|BLAST|CUTADAPT' { cpus = 4 }
    // The archive intermittently answers "403 Forbidden" under load: wait longer each time and retry.
    withName: 'DOWNLOAD' {
        cpus = 1
        maxRetries = 8
        errorStrategy = { sleep((Math.pow(2, task.attempt) * 15000) as long); 'retry' }
    }
}

profiles {
    // plain conda, not mamba: a conda install has no mamba binary, and conda >= 23.10 solves with libmamba anyway
    conda       { conda.enabled = true }
    micromamba  { conda.enabled = true; conda.useMicromamba = true }
    docker      { docker.enabled = true;      wave.enabled = true; wave.strategy = ['conda'] }
    singularity { singularity.enabled = true; singularity.autoMounts = true; wave.enabled = true; wave.strategy = ['conda'] }
    dev         { params.max_samples = 20; params.outdir = 'results_dev' }
}

report.overwrite = true; timeline.overwrite = true; dag.overwrite = true
manifest { name = 'nectarflow'; description = 'Nextflow reimplementation and reanalysis of the NBGW plant DNA metabarcoding pipeline (Lowe et al. 2022)'; nextflowVersion = '>=23.10' }
